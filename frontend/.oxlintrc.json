{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "import", "promise", "unicorn", "vitest", "jsx-a11y"],
  "jsPlugins": ["./lint/anvil.ts"],
  // warnings don't fail lint, so a plugin's correctness rules must be errors to catch anything
  "categories": { "correctness": "error" },
  // generated by scripts/generate_api_schema.py
  "ignorePatterns": ["src/lib/api-schema.d.ts"],
  "rules": {
    "anvil/comment-above-declaration": "error",
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    // <output> is for a calculation's result; our status messages aren't, so role="status" is right
    "jsx-a11y/prefer-tag-over-role": "off",
    "react/no-danger": "error",
    "react/jsx-no-script-url": "error",
    "react/jsx-no-target-blank": "error",
    "no-eval": "error",
    "no-new-func": "error",
    // type-aware: only runs under `oxlint --type-aware`, as `npm run lint` does
    "typescript/no-implied-eval": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-deprecated": "error",
    "typescript/no-unnecessary-condition": "error",
    // `flag || undefined` drops an attribute when false, which ?? wouldn't
    "typescript/prefer-nullish-coalescing": ["error", { "ignorePrimitives": { "boolean": true } }],
    "no-shadow": "error",
    "react/no-array-index-key": "error",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            // shadcn sometimes generates this import; our cn knows the theme's sizes and radii
            "name": "cn",
            "message": "Import cn from @/lib/utils."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      // shadcn's `value || 0`; ?? means the same here, so not worth hand-editing a primitive
      "files": ["src/components/ui/progress.tsx"],
      "rules": {
        "typescript/prefer-nullish-coalescing": "off"
      }
    },
    {
      // shadcn primitives: they export their variants alongside the component,
      // and depend on nothing app-specific
      "files": ["src/components/ui/**"],
      "rules": {
        "react/only-export-components": "off",
        "anvil/comment-above-declaration": "off",
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "cn",
                "message": "Import cn from @/lib/utils."
              }
            ],
            "patterns": [
              {
                "group": ["@/**", "!@/lib/utils", "!@/components/ui/**", "!@/hooks/**", "../**"],
                "message": "ui/ holds shadcn primitives only; they can't depend on app code."
              }
            ]
          }
        ]
      }
    }
  ]
}
