# Copy to .env (git-ignored) and adjust as needed: cp .env.example .env

# Used by compose.yaml to initialise the local Postgres container.
POSTGRES_USER=anvil
POSTGRES_PASSWORD=anvil
POSTGRES_DB=anvil

# Used by the app and Alembic.
DATABASE_URL=postgresql+psycopg://anvil:anvil@localhost:5432/anvil
