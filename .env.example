# Copy to .env (git-ignored) and adjust as needed: cp .env.example .env

# Used by compose.yaml to initialise the local Postgres container.
POSTGRES_USER=anvil
POSTGRES_PASSWORD=anvil
POSTGRES_DB=anvil

# Used by the app and Alembic.
DATABASE_URL=postgresql+psycopg://anvil:anvil@localhost:5432/anvil

# Until there is authentication, every request acts as this person, created on
# first use. Both are optional; these are the defaults.
# STUB_USER_NAME=Dev User
# STUB_USER_EMAIL=dev@example.com

# Which refinement agent to use: `stub` (the default), deterministic and offline,
# or `model`, which asks the language model in AGENT_MODEL (`provider:model`).
# The provider reads its own API key variable; set the one for your provider.
# AGENT=stub

# Anthropic:
# AGENT_MODEL=anthropic:claude-sonnet-5-5
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI:
# AGENT_MODEL=openai:<model>
# OPENAI_API_KEY=sk-...

# OVHcloud AI Endpoints:
# AGENT_MODEL=ovhcloud:gpt-oss-20b
# OVHCLOUD_API_KEY=...

# Another OpenAI-compatible server:
# AGENT_MODEL=openai-chat:<model>
# OPENAI_BASE_URL=http://localhost:8080/v1

# How many seconds the model agent may take over one call before it gives up.
# AGENT_TIMEOUT_SECONDS=60

# Make every stub agent call this many milliseconds slow, to see loading states.
# STUB_AGENT_DELAY_MS=0

# The example idea shown in the home page's empty prompt. This is the default.
# IDEA_PLACEHOLDER=Drivers should see route changes on their phone without calling the depot
