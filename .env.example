# Copy to .env (git-ignored) and adjust as needed: cp .env.example .env

# Used by compose.yaml to initialise the local Postgres container.
POSTGRES_USER=anvil
POSTGRES_PASSWORD=anvil
POSTGRES_DB=anvil

# Used by the app and Alembic.
DATABASE_URL=postgresql+psycopg://anvil:anvil@localhost:5432/anvil

# Until there is authentication, every request acts as this person, created on
# first use. Both are optional; these are the defaults.
# STUB_USER_NAME=Dev User
# STUB_USER_EMAIL=dev@example.com

# Which refinement agent to use. Only `stub` exists for now: deterministic and
# offline, it titles a requirement with the first words of its idea. This is the
# default.
# AGENT=stub
# Make every stub agent call this many milliseconds slow, to see loading states.
# STUB_AGENT_DELAY_MS=0

# The Project Context, handed to the agent. Optional; with no file at the path
# there is none, but a file that can't be read stops the app starting. Relative
# paths are from the repo root.
# PROJECT_CONTEXT_FILE=context.md
